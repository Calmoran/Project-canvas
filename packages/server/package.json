{
  "name": "@canvas/server",
  "version": "0.0.0",
  "private": true,
  "description": "The local Canvas server: configuration, HTTP API, scan progress",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "@canvas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "@canvas/source": "./src/api/index.ts",
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.5"
  }
}
